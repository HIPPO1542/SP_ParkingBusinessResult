  "item": [
    {
      "name": "1. Xác thực",
      "item": [
        {
          "name": "Đăng nhập quản trị viên",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.body.update(JSON.stringify({ username: pm.variables.get('adminUsername') || '', password: pm.variables.get('adminPassword') || '' }));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('accessToken');",
                  "const response = pm.response.json();",
                  "pm.test('HTTP 200 và đăng nhập thành công', function () { pm.response.to.have.status(200); pm.expect(response.code).to.eql(0); pm.expect(response.data.accessToken).to.be.a('string').and.not.empty; });",
                  "if (response.code === 0 && response.data && response.data.accessToken) pm.collectionVariables.set('accessToken', response.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Nhập tài khoản quản trị đã khởi tạo vào biến adminUsername và adminPassword. Token hết hạn sau 30 phút."
          }
        },
        {
          "name": "Tạo tài khoản vận hành (không bắt buộc)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.body.update(JSON.stringify({ username: pm.variables.get('operatorUsername') || '', password: pm.variables.get('operatorPassword') || '', role: 'ROLE_PARKING_OPERATOR', parkingLotId: pm.variables.get('parkingLotId') || '' }));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "pm.test('HTTP 200 và tạo tài khoản thành công', function () { pm.response.to.have.status(200); pm.expect(response.code).to.eql(0); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{operatorUsername}}\",\n  \"password\": \"{{operatorPassword}}\",\n  \"role\": \"ROLE_PARKING_OPERATOR\",\n  \"parkingLotId\": \"{{parkingLotId}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/users",
            "description": "Cần token quản trị. Đặt operatorUsername và operatorPassword, mật khẩu từ 12 đến 256 ký tự; mỗi tên chỉ tạo một lần."
          }
        }
      ]
    },
    {
      "name": "2. Lượt xe booking",
      "item": [
        {
          "name": "Lấy bãi xe và loại xe",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/gdci/parking/parkingLot/parkingBooking/filters",
            "description": "Tự điền parkingLotId bằng bãi đầu tiên nếu biến trống; có thể chọn ID khác từ response."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "pm.test('HTTP 200 và code 0', () => { pm.response.to.have.status(200); pm.expect(response.code).to.eql(0); });",
                  "if (response.code === 0 && response.data && response.data.parkingLots.length && !pm.variables.get('parkingLotId')) pm.collectionVariables.set('parkingLotId', response.data.parkingLots[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Import file lượt xe",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "pm.test('HTTP 200 và code 0', () => { pm.response.to.have.status(200); pm.expect(response.code).to.eql(0); });",
                  "pm.test('Có tổng kết import', () => pm.expect(response.data).to.include.all.keys('totalRows','successRows','errorRows','duplicateRows','importedIds','importedRows','errors'));",
                  "if (response.code === 0 && response.data && response.data.importedIds.length) pm.collectionVariables.set('bookingId', response.data.importedIds[0]);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": "{{baseUrl}}/gdci/parking/parkingLot/businessOperation/import",
            "description": "Body > form-data > file: chọn Excel/CSV theo mẫu outputs/import-20261106/. Dòng hợp lệ ghi vào SP_datTruocChoDoXe; tiền lưu vào tongTien. Trùng bãi + biển số chuẩn hóa + giờ vào: báo lỗi, không cập nhật."
          }
        },
        {
          "name": "Danh sách lượt xe",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/gdci/parking/parkingLot/parkingBooking?pageNumber=1&pageSize=10",
            "description": "Mặc định 10 dòng/trang. Xem totalCount; tăng pageNumber hoặc pageSize (tối đa 100). Tự lưu bookingId từ dòng đầu."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "pm.test('HTTP 200 và code 0', () => { pm.response.to.have.status(200); pm.expect(response.code).to.eql(0); });",
                  "pm.test('Có phân trang', () => pm.expect(response.data).to.include.all.keys('items','totalCount','pageNumber','pageSize'));",
                  "if (response.code === 0 && response.data && response.data.items.length) pm.collectionVariables.set('bookingId', response.data.items[0].id);"
                ]
              }
            }
