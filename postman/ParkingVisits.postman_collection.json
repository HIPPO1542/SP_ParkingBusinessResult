{
  "info": {
    "name": "Parking Visits - Development",
    "description": "Import từng lượt xe và kiểm tra báo cáo từ dữ liệu đã import. Chỉ dành cho Development.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5069" },
    { "key": "adminUsername", "value": "" },
    { "key": "adminPassword", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "reportingPeriod", "value": "2026-11" },
    { "key": "visitId", "value": "" },
    { "key": "dayType", "value": "WEEKDAY" }
  ],
  "item": [
    {
      "name": "Đăng nhập",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const response = pm.response.json();",
        "pm.collectionVariables.unset('accessToken');",
        "if (response.code === 0 && response.data && response.data.accessToken) pm.collectionVariables.set('accessToken', response.data.accessToken);",
        "pm.test('Đăng nhập thành công', () => pm.expect(response.code).to.eql(0));"
      ] } }],
      "request": { "method": "POST", "auth": { "type": "noauth" }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}" }, "url": "{{baseUrl}}/dev/auth/login" }
    },
    {
      "name": "Import file lượt xe",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const response = pm.response.json();",
        "if (response.code === 0 && response.data && response.data.importedIds && response.data.importedIds.length) pm.collectionVariables.set('visitId', response.data.importedIds[0]);",
        "pm.test('Import trả kết quả', () => pm.expect(response.code).to.eql(0));"
      ] } }],
      "request": { "method": "POST", "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": [] }] }, "url": "{{baseUrl}}/dev/parking-visits/import", "description": "Chọn file .xlsx, .xls hoặc .csv theo mẫu. Dữ liệu hợp lệ sẽ được lưu vào database; nhập lại cùng bãi, biển số và giờ vào sẽ cập nhật lượt cũ." }
    },
    { "name": "Danh sách lượt đang trong bãi", "request": { "method": "GET", "url": "{{baseUrl}}/dev/parking-visits?status=PARKED&pageNumber=1&pageSize=10" } },
    { "name": "Danh sách lượt đã ra", "request": { "method": "GET", "url": "{{baseUrl}}/dev/parking-visits?status=COMPLETED&pageNumber=1&pageSize=10" } },
    { "name": "Thống kê theo tháng", "request": { "method": "GET", "url": "{{baseUrl}}/dev/parking-visits/summary?reportingPeriod={{reportingPeriod}}", "description": "Tính theo ngày xe ra; missingAmountCount cho biết số lượt hoàn tất chưa có tiền thực thu." } },
    { "name": "Thống kê theo khoảng ngày", "request": { "method": "GET", "url": "{{baseUrl}}/dev/parking-visits/summary?fromDate=2026-11-01&toDate=2026-11-30" } },
    { "name": "Đối chiếu bảng giá", "request": { "method": "GET", "url": "{{baseUrl}}/dev/parking-visits/{{visitId}}/tariff-comparison?dayType={{dayType}}", "description": "Chọn WEEKDAY, WEEKEND hoặc HOLIDAY; một số trường hợp chưa đủ quy tắc sẽ không tính." } },
    { "name": "Xuất Excel", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fileFormat\": \"EXCEL\",\n  \"reportingPeriod\": \"{{reportingPeriod}}\"\n}" }, "url": "{{baseUrl}}/dev/parking-visits/export", "description": "Dùng Send and Download để lưu tệp; yêu cầu admin hoặc district admin." } },
    { "name": "Xuất PDF", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fileFormat\": \"PDF\",\n  \"reportingPeriod\": \"{{reportingPeriod}}\"\n}" }, "url": "{{baseUrl}}/dev/parking-visits/export", "description": "Dùng Send and Download. PDF thử nghiệm cần Windows và font Arial." } }
  ]
}
